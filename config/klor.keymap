//                               █         █    █            ▄▄▄▀▀▀▀▀▀▄▄▄        █▀▀▀▀▀▀▀▀▀▀█
//                               █        █     █          ▄▀            ▀▄      █          █
//                               █       █      █        ▄▀                ▀▄    █          █
//                               █      █       █        █                  █    █          █
//                               █     █        █       █                    █   █          █
//                               █    █         █       █                    █   █▄▄▄▄▄▄▄▄▄▄█
//                               █   █ █        █       █                    █   █      █
//                               █  █   █       █        █                  █    █       █
//                               █ █     █      █        ▀▄                ▄▀    █        █
//                               ██       █     █          ▀▄            ▄▀      █         █
//                               █         █    █▄▄▄▄▄▄▄▄    ▀▀▀▄▄▄▄▄▄▀▀▀        █          █
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE   0
#define NAV  1
#define NUMSYM  2
#define FUNC 3
#define MEDMOD 4
#define ADJUST 5
#define MOUSE 6
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        base_layer {
            // ┌───────────────────────────────────────────────────────────┐

            label = "BASE";

            // └───────────────────────────────────────────────────────────┘
            /*           ┌─────────┬─────────┬─────────┬─────────┬─────────┐                    ┌─────────┬─────────┬─────────┬─────────┬─────────┐
             │    Q    │    W    │    F    │    P    │    G    │                    │    J    │    L    │    U    │    Y    │    ;    │   
   ┌─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤                    ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┐
   │   TAB   │    A    │    R    │    S    │    T    │    D    │                    │    H    │    N    │    E    │    I    │    O    │    "    │
   ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤╭────────╮╭────────╮├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤
   │   DEL   │    Z    │    X    │    C    │    V    │    B    ││  MUTE  ││PLY/PSE ││    K    │    M    │    ,    │    .    │    /    │    \    │
   └─────────┴─────────┴─────────┼─────────┼─────────┼─────────┼╰────────╯╰────────╯┼─────────┼─────────┼─────────┼─────────┴─────────┴─────────┘
                                 │  CTRL   │  LOWER  │  SPACE  │   ALT   ││ CMD/WIN │  ENTER  │  RAISE  │  BSPCE  │  
                                 └─────────┴─────────┴─────────┴─────────┘└─────────┴─────────┴─────────┴─────────┘ */

            bindings = <
            &kp Q  &kp W  &kp F      &kp P        &kp G                                               &kp J          &kp L        &kp U      &kp Y    &kp SEMI
&kp TAB     &kp A  &kp R  &kp S      &kp T        &kp D                                               &kp H          &kp N        &kp E      &kp I    &kp O      &kp SQT
&kp ESCAPE  &kp Z  &kp X  &kp C      &kp V        &kp B           &kp C_PLAY_PAUSE  &kp C_PLAY_PAUSE  &kp K          &kp M        &kp COMMA  &kp DOT  &kp SLASH  &kp GRAVE
                          &kp LCTRL  &lt 3 SPACE  &kp LEFT_SHIFT  &kp LALT          &kp LGUI          &kp BACKSPACE  &lt 2 ENTER  &kp RCTRL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        qwerty_layer {
            label = "QWERTY";
            bindings = <
            &kp Q  &kp W  &kp E      &kp R        &kp T                                               &kp Y          &kp U        &kp I      &kp O    &kp P
&kp TAB     &kp A  &kp S  &kp D      &kp F        &kp G                                               &kp H          &kp J        &kp K      &kp L    &kp SEMI   &kp SQT
&kp ESCAPE  &kp Z  &kp X  &kp C      &kp V        &kp B           &kp C_PLAY_PAUSE  &kp C_PLAY_PAUSE  &kp N          &kp M        &kp COMMA  &kp DOT  &kp SLASH  &kp GRAVE
                          &kp LCTRL  &lt 3 SPACE  &kp LEFT_SHIFT  &kp LALT          &kp LGUI          &kp BACKSPACE  &lt 2 ENTER  &kp RCTRL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        nav_layer {
            bindings = <
        &trans        &trans        &mo 6           &trans     &trans                  &kp TAB   &kp PAGE_UP     &kp UP_ARROW    &kp BACKSPACE    &kp DEL
&trans  &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_SHIFT  &kp LCTRL  &trans                  &kp HOME  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp END  &trans
&trans  &trans        &trans        &trans          &trans     &trans  &trans  &trans  &trans    &kp PAGE_DOWN   &trans          &trans           &trans   &trans
                                    &mo 4           &trans     &mo 7   &trans  &trans  &trans    &trans          &trans
            >;

            label = "NAV";
        };

        numsym_layer {
            // ┌───────────────────────────────────────────────────────────┐

            label = "NUMSYM";

            // └───────────────────────────────────────────────────────────┘
            /*           ┌─────────┬─────────┬─────────┬─────────┬─────────┐                    ┌─────────┬─────────┬─────────┬─────────┬─────────┐
             │         │         │         │         │         │                    │         │         │    Ü    │         │         │
   ┌─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤                    ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┐
   │    Ä    │         │    ß    │         │         │         │                    │         │         │         │         │    Ö    │         │
   ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤╭────────╮╭────────╮├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤
   │         │         │         │         │         │         ││        ││        ││         │         │         │         │         │         │
   └─────────┴─────────┴─────────┼─────────┼─────────┼─────────┼╰────────╯╰────────╯┼─────────┼─────────┼─────────┼─────────┴─────────┴─────────┘
                                 │ ADJUST  │         │         │         ││         │         │         │         │  
                                 └─────────┴─────────┴─────────┴─────────┘└─────────┴─────────┴─────────┴─────────┘ */

            bindings = <
            &kp CARET        &kp AT_SIGN    &kp HASH          &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS                  &kp PLUS         &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp MINUS
&kp DOLLAR  &kp EXCLAMATION  &kp AMPERSAND  &kp PIPE          &kp LEFT_BRACE        &kp RIGHT_BRACE                        &kp EQUAL        &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK   &kp KP_DOT
&kp SLASH   &kp UNDER        &kp LESS_THAN  &kp GREATER_THAN  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans  &trans  &kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp BACKSLASH  &kp PERCENT
                                            &trans            &trans                &trans                 &trans  &trans  &kp RIGHT_SHIFT  &trans           &mo 5
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        function_layer {
            bindings = <
        &trans         &trans        &trans      &trans     &trans                  &kp F1  &kp F2   &kp F3   &kp F4   &kp INS
&trans  &kp LEFT_META  &kp LEFT_ALT  &kp LSHIFT  &kp LCTRL  &trans                  &kp F5  &kp F6   &kp F7   &kp F8   &kp PRINTSCREEN  &trans
&trans  &trans         &trans        &trans      &trans     &trans  &trans  &trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans           &trans
                                     &trans      &trans     &trans  &trans  &trans  &trans  &trans   &trans
            >;

            label = "FUNC";
        };

        mod_layer {
            bindings = <
        &trans  &trans  &kp C_VOLUME_UP    &kp C_PREV  &trans                            &trans  &trans  &trans  &kp LS(LC(KP_MINUS))  &trans
&trans  &trans  &trans  &kp C_VOLUME_DOWN  &kp C_NEXT  &kp C_PLAY_PAUSE                  &trans  &trans  &trans  &trans                &trans  &trans
&trans  &trans  &trans  &trans             &trans      &trans            &trans  &trans  &trans  &trans  &trans  &trans                &trans  &trans
                        &trans             &trans      &trans            &trans  &trans  &trans  &trans  &trans
            >;

            label = "MEDMOD";
        };

        adjust_layer {
            // ┌───────────────────────────────────────────────────────────┐

            label = "ADJUST";

            // └───────────────────────────────────────────────────────────┘
            /*           ┌─────────┬─────────┬─────────┬─────────┬─────────┐                    ┌─────────┬─────────┬─────────┬─────────┬─────────┐
             │         │         │         │         │         │                    │         │         │         │         │         │
   ┌─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤                    ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┐
   │         │         │         │         │         │         │                    │         │         │         │         │         │         │
   ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤╭────────╮╭────────╮├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤
   │         │         │         │         │         │         ││        ││        ││         │         │         │         │         │         │
   └─────────┴─────────┴─────────┼─────────┼─────────┼─────────┼╰────────╯╰────────╯┼─────────┼─────────┼─────────┼─────────┴─────────┴─────────┘
                                 │         │         │         │         ││         │         │         │         │  
                                 └─────────┴─────────┴─────────┴─────────┘└─────────┴─────────┴─────────┴─────────┘ */

            bindings = <
        &trans  &trans  &trans  &bt BT_PRV  &bt BT_NXT                  &to 0   &to 1   &tog 8  &tog 9  &trans
&trans  &trans  &trans  &trans  &trans      &trans                      &trans  &trans  &trans  &trans  &trans  &bt BT_CLR
&trans  &trans  &trans  &trans  &trans      &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &bt BT_CLR_ALL
                        &trans  &trans      &trans      &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        mouse_layer {
            bindings = <
        &trans        &trans        &trans          &trans     &trans                  &msc SCRL_LEFT  &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &msc SCRL_RIGHT
&trans  &kp LEFT_WIN  &kp LEFT_ALT  &kp LEFT_SHIFT  &kp LCTRL  &trans                  &msc SCRL_UP    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN   &trans
&trans  &trans        &trans        &trans          &trans     &trans  &trans  &trans  &trans          &trans          &mkp MCLK       &trans           &trans           &trans
                                    &trans          &trans     &trans  &trans  &trans  &trans          &trans          &trans
            >;

            label = "MOUSE";
        };

        fps_layer {
            bindings = <
         &kp ESCAPE      &kp Q  &kp E      &kp R      &kp T                   &trans  &trans  &tog 8  &trans  &trans
&kp TAB  &kp LEFT_SHIFT  &kp A  &kp W      &kp D      &kp F                   &trans  &trans  &trans  &trans  &trans  &trans
&trans   &kp X           &kp C  &kp S      &kp V      &kp G   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                &kp LCTRL  &kp SPACE  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            label = "FPS";
        };

        moba_layer {
            bindings = <
        &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            label = "MOBA";
        };
    };
};
